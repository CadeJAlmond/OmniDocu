# OmniDocu Environment Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# Server Configuration
# =============================================================================
PORT=3001
NODE_ENV=development

# =============================================================================
# PostgreSQL Database Configuration
# For Docker Compose, use service name 'postgres'
# For production AWS RDS, use your RDS endpoint
# =============================================================================
DB_HOST=postgres
DB_PORT=5432
DB_USER=omnidocu
DB_PASSWORD=omnidocu_password
DB_NAME=omnidocu_db
DB_SSL=false

# =============================================================================
# AWS S3 Configuration
# For local development with Docker, S3 is not used automatically
# For production, configure your AWS credentials
# =============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=omnidocu-documents

# =============================================================================
# JWT Configuration
# IMPORTANT: Use a strong, unique secret in production (min 32 characters)
# Generate with: openssl rand -base64 32
# =============================================================================
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGIN=http://localhost:3000

# =============================================================================
# PGAdmin Configuration (for Docker Compose)
# =============================================================================
PGADMIN_EMAIL=admin@omnidocu.local
PGADMIN_PASSWORD=admin_password